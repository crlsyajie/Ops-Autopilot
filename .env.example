# Copy to .env and fill in what you use. Nothing here is required for the offline demo.

# Claude. Without a key the app runs in replay mode (answers from the eval labels).
ANTHROPIC_API_KEY=

# auto (default) | live | replay
AUTOPILOT_LLM=auto
AUTOPILOT_MODEL=claude-opus-5-5
AUTOPILOT_EXTRACT_EFFORT=medium
AUTOPILOT_AGENT_EFFORT=high
AUTOPILOT_AGENT_MAX_STEPS=6

# Where the database, inbox, archive and ledgers live (default ./var)
AUTOPILOT_DATA_DIR=
AUTOPILOT_PUBLIC_URL=http://127.0.0.1:8000

# Optional integrations
SLACK_WEBHOOK_URL=
SHEETS_WEBHOOK_URL=

# Optional email trigger (Gmail: imap.gmail.com + an app password)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SEARCH=UNSEEN
